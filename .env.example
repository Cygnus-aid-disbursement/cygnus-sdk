# Cygnus SDK Environment Configuration Example
# Copy this file to .env and replace placeholder values with your credentials.

# Network Selection ("testnet" or "standalone")
CYGNUS_NETWORK=testnet

# Cygnus Programme Contract ID on Stellar Soroban (56-character C... address)
# If omitted, defaults to the canonical deployment address in src/deployments.json
CYGNUS_CONTRACT_ID=CA3D5KRYM6CB7OWQ6TWYRR3Z4T7GNZLKERYNZGGA5SOAOPIFY6YQGAXE

# Soroban RPC URL
CYGNUS_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Network Passphrase
CYGNUS_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Operator / Signer Stellar Secret Key (56-character S... secret seed)
# Used by Cygnus.fromEnv() to automatically configure a basicNodeSigner
STELLAR_SECRET=SBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Signer Public Key (56-character G... address)
# Derived automatically when STELLAR_SECRET is provided
STELLAR_PUBLIC_KEY=GBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Allow unencrypted HTTP RPC endpoints (e.g. for local standalone containers)
CYGNUS_ALLOW_HTTP=false

# Enable or disable automatic exponential backoff retry on RPC failures ("true" or "false")
CYGNUS_RETRY=true
